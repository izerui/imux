<idea-plugin>
    <id>com.github.izerui.imux</id>
    <name>imux</name>
    <vendor>izerui</vendor>

    <description><![CDATA[
      在左侧工具窗口中列出当前项目的 Claude Code 与 Codex 会话，
      点击会话即在编辑器标签页中打开对应的 CLI 终端。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="imux"
            anchor="left"
            icon="/icons/agent.svg"
            factoryClass="com.github.izerui.imux.toolwindow.AgentToolWindowFactory"/>

        <!--
          必须注册：否则没有任何 provider 接受 AgentTerminalVirtualFile，
          FileEditorManagerImpl.openFileImpl 会因「该文件无可用编辑器」当场调用
          closeFile，表现为标签页打开后一闪而过。
        -->
        <fileEditorProvider
            implementation="com.github.izerui.imux.terminal.AgentTerminalFileEditorProvider"/>

        <!-- 会话轮次完成时的提醒气泡；用户可在 IDE 设置里关闭 -->
        <notificationGroup id="imux.turnCompleted" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
