<idea-plugin>
    <id>com.github.izerui.imux</id>
    <name>imux</name>
    <vendor url="https://github.com/izerui/imux">izerui</vendor>

    <!--
      两条硬约束，改文案前先看：
      1. Marketplace 只渲染有限的 HTML 子集（p / ul / li / b / em / code / a / br），
         不解析 Markdown——别写 ** 或 - 列表。
      2. 描述必须以拉丁字符开头，所以首行是不带标签的英文摘要；
         若把它挪进 <p> 或删掉，PluginXmlRegistrationTest 会失败。
      3. 按 Marketplace 上架最佳实践，英文描述在前、中文简介在后；新增功能两边都要补，
         功能名用 ImuxBundle.properties 里的英文名（AI Agents、Talk First、Transfer Session……）。
    -->
    <description><![CDATA[
      imux turns your JetBrains IDE into an AI coding cockpit: run Claude Code, Codex, and Pi sessions in editor tabs, and let them use your IDE through IDEA MCP.

      <p><b>Why imux instead of running AI agents in a plain terminal?</b><br>
      AI coding agents work like a programmer who only has a text editor and a terminal: they read and write files and run commands,
      but cannot use the IDE's refactoring, debugger, inspections, or run configurations. imux closes that gap.</p>

      <p><b>Use IDE tools through IDEA MCP</b></p>
      <ul>
        <li><b>Safe refactoring</b>: rename symbols semantically across the project instead of replacing text</li>
        <li><b>Interactive debugging</b>: set breakpoints, step through code, inspect variables, evaluate expressions</li>
        <li><b>IDE inspections</b>: catch framework issues that compilers and linters miss (Spring, Django, ESLint, Android, and more)</li>
        <li><b>Run configurations</b>: run tests and apps with the same environment, arguments, and working directory as the IDE</li>
        <li><b>Database access</b>: query databases through connections and credentials already saved in the IDE</li>
        <li><b>Formatting and navigation</b>: format with the project code style, trace call hierarchies, find definitions</li>
      </ul>
      <p>The MCP configuration is injected only into sessions started by imux; the global CLI configuration is not modified.
      Available tools depend on the IDE, installed plugins, and the MCP server version.</p>

      <p><b>Sessions</b></p>
      <ul>
        <li>The <b>AI Agents</b> tool window groups sessions by agent; running sessions show a spinner, sessions with new replies are shown in bold</li>
        <li>Sessions run in <b>editor tabs</b> next to your code: split, reorder, or drag them to another window</li>
        <li>Double-click any past session to resume it</li>
        <li><b>Notifications</b> when a turn finishes or needs your input, with duration and session title</li>
        <li><b>Message navigation</b>: jump to any earlier prompt in a long session</li>
        <li><b>Transfer Session</b>: continue a Claude Code session in Codex or Pi, with a prompt that carries over the context</li>
      </ul>

      <p><b>Review and planning</b></p>
      <ul>
        <li><b>Pair Programming</b>: bind another agent as a co-pilot that reviews every turn and sends its feedback back to the main session</li>
        <li><b>Review Once</b>: a one-time review by any agent, with your own instructions</li>
        <li><b>Talk First</b>: before writing code, the agent asks the key questions one by one based on your project, then turns the answers into a plan</li>
        <li><b>Session Trail</b>: condense a long session into a timeline of progress, requirement changes, errors, and abandoned approaches</li>
      </ul>

      <p><b>Phone Bridge</b></p>
      <ul>
        <li>Continue a session from a Feishu (Lark), WeCom, DingTalk, or WeChat bot: phone messages go straight into the terminal, and each turn's result comes back to your phone</li>
        <li>Sessions can send screenshots, videos, and files to your phone</li>
      </ul>

      <p>imux does not store your conversations. History stays in each CLI's own storage and remains intact after the plugin is uninstalled.</p>

      <p><b>Requirements</b>: JetBrains IDE 2026.2 or later (build 262+) and at least one of <code>claude</code>, <code>codex</code>, or <code>pi</code>.</p>

      <p><a href="https://github.com/izerui/imux">Source code</a> | <a href="https://github.com/izerui/imux/issues">Issue tracker</a> | <a href="https://github.com/izerui/imux/blob/main/docs/guide.md">User guide (Chinese)</a></p>

      <p><b>中文简介</b></p>
      <p>把 JetBrains IDE 变成 AI 编程驾驶舱：在编辑器标签页里运行 Claude Code、Codex 和 Pi 会话，并通过 IDEA MCP 让它们用上 IDE 的能力。</p>
      <ul>
        <li><b>IDEA MCP</b>：语义重命名、断点调试、IDE 级代码检查、运行配置、已保存的数据库连接、按项目代码风格格式化；只注入 imux 启动的会话，不改 CLI 的全局配置</li>
        <li><b>会话面板</b>：按智能体分组，运行中转圈、有新回复加粗；双击接着聊；跑完或需要输入时提醒；长会话内消息导航</li>
        <li><b>会话转移</b>：把 Claude Code 的工作带着前情交给 Codex 或 Pi 接着干</li>
        <li><b>结对编程与审查一次</b>：另一个智能体当副驾驶，审查每一轮并把意见发回主会话</li>
        <li><b>先聊再做</b>：动手前，智能体结合项目代码一题一题问清楚，再整理成方案</li>
        <li><b>会话轨迹</b>：把长会话浓缩成进展时间线，标出需求变更、报错和放弃的方案</li>
        <li><b>手机桥接</b>：用飞书、企业微信、钉钉或微信机器人在手机上接着聊，截图和文件也能发到手机</li>
      </ul>
      <p>imux 不托管你的对话：会话历史保存在各 CLI 自己的存储里，卸载插件后完整保留。运行要求：JetBrains IDE 2026.2 及以上，并至少安装 <code>claude</code>、<code>codex</code>、<code>pi</code> 其中一个。</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <!-- 会话装饰：其它功能给终端标签、会话树、终端顶部加的标记与横幅。现有代码只认这个接口。 -->
    <extensionPoints>
        <extensionPoint
                qualifiedName="com.github.izerui.imux.terminalLaunchContributor"
                interface="com.github.izerui.imux.terminal.TerminalLaunchContributor"
                dynamic="true"/>
        <extensionPoint
                qualifiedName="com.github.izerui.imux.sessionDecorator"
                interface="com.github.izerui.imux.terminal.SessionDecorator"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="com.github.izerui.imux.settings.ImuxSettingsConfigurable"
                id="com.github.izerui.imux.settings"
                displayName="Imux"/>

        <!--
          LSP 体检子页。挂在 Imux 之下而不是 tools 根，避免在 Tools 里再多出一个
          与 imux 无关联的顶层条目。
        -->
        <applicationConfigurable
                parentId="com.github.izerui.imux.settings"
                instance="com.github.izerui.imux.settings.ImuxIdeaMcpConfigurable"
                id="com.github.izerui.imux.settings.ideaMcp"
                displayName="IDEA MCP"/>

        <applicationConfigurable
                parentId="com.github.izerui.imux.settings"
                instance="com.github.izerui.imux.settings.ImuxLspConfigurable"
                id="com.github.izerui.imux.settings.lsp"
                displayName="LSP"/>

        <applicationConfigurable
                parentId="com.github.izerui.imux.settings"
                instance="com.github.izerui.imux.bridge.ui.RobotsConfigurable"
                id="com.github.izerui.imux.settings.bridge"
                key="bridge.settings.displayName"
                bundle="messages.ImuxBundle"/>

        <toolWindow
                id="imux"
                anchor="left"
                icon="/icons/agent.svg"
                factoryClass="com.github.izerui.imux.toolwindow.AgentToolWindowFactory"/>

        <!--
          必须注册：否则没有任何 provider 接受 AgentTerminalVirtualFile，
          FileEditorManagerImpl.openFileImpl 会因「该文件无可用编辑器」当场调用
          closeFile，表现为标签页打开后一闪而过。
        -->
        <fileEditorProvider
                implementation="com.github.izerui.imux.terminal.AgentTerminalFileEditorProvider"/>

        <editorTabTitleProvider
                implementation="com.github.izerui.imux.terminal.AgentTerminalTabTitleProvider"/>

        <fileIconProvider
                implementation="com.github.izerui.imux.terminal.AgentTerminalFileIconProvider"/>

        <!--
          只拦截用户通过编辑器关闭链发起的操作；进程自然退出和内部清理使用无检查的
          closeFile，因此不会在自动关闭时打断用户。
        -->
        <virtualFilePreCloseCheck
                implementation="com.github.izerui.imux.terminal.AgentSessionPreCloseCheck"/>

        <!--
          覆盖平台的窗口标题构建器，给有未读会话的项目名加星号前缀。
          macOS 把多个项目窗口合并成标签栏后，标签上只有 NSWindow title，
          未读状态若不送到这里，切出该项目就完全不可见。
        -->
        <applicationService
                serviceInterface="com.intellij.openapi.wm.impl.FrameTitleBuilder"
                serviceImplementation="com.github.izerui.imux.frame.AgentFrameTitleBuilder"
                overrides="true"/>

        <!-- 会话轮次完成时的提醒气泡；用户可在 IDE 设置里关闭 -->
        <notificationGroup id="imux.turnCompleted" displayType="BALLOON"/>
        <notificationGroup id="imux.ideaMcp" displayType="BALLOON"/>
        <notificationGroup id="imux.phoneBridge" displayType="BALLOON"/>
        <!-- Marketplace 有兼容的新版本时提醒升级；用户可在 IDE 通知设置里关闭 -->
        <notificationGroup id="imux.update" displayType="BALLOON"/>

        <!--
          必须注册：工具窗口的内容是懒加载的，监听逻辑若只在 createToolWindowContent
          里启动，从没展开过 imux 面板的项目就一条提醒都收不到，而用户不会察觉。
        -->
        <postStartupActivity
                implementation="com.github.izerui.imux.monitor.ImuxStartupActivity"/>

        <!-- 终端会话通讯桥接：仅在开关打开时启动，见 docs/terminal-channel-bridge-feasibility.md -->
        <postStartupActivity
                implementation="com.github.izerui.imux.bridge.BridgeStartupActivity"/>
        <postStartupActivity
                implementation="com.github.izerui.imux.bridge.ui.BridgeNotificationsActivity"/>
        <postStartupActivity
                implementation="com.github.izerui.imux.update.UpdateReminderActivity"/>

        <!--
          接收 pi 扩展的会话上报。pi 的会话切换（/new、/resume、/fork）无法从进程外
          观测，只能由它自己上报，见 PiSessionReportHandler 的说明。
        -->
        <httpRequestHandler implementation="com.github.izerui.imux.session.PiSessionReportHandler"/>
        <httpRequestHandler implementation="com.github.izerui.imux.bridge.mcp.MobileMcpHandler"/>
        <httpRequestHandler implementation="com.github.izerui.imux.bridge.mcp.ClaudeHookHandler"/>
        <httpRequestHandler implementation="com.github.izerui.imux.peer.mcp.PeerMcpHandler"/>

        <statusBarWidgetFactory
                id="imux.phoneBridge"
                implementation="com.github.izerui.imux.bridge.ui.PhoneStatusWidgetFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.github.izerui.imux">
        <terminalLaunchContributor implementation="com.github.izerui.imux.bridge.mcp.MobileLaunchContributor"/>
        <terminalLaunchContributor implementation="com.github.izerui.imux.peer.mcp.PeerLaunchContributor"/>
        <sessionDecorator implementation="com.github.izerui.imux.bridge.ui.BridgeSessionDecorator"/>
    </extensions>

    <actions>
        <group
                id="imux.ProjectNewAgent"
                class="com.github.izerui.imux.toolwindow.ProjectNewAgentActionGroup"
                popup="true"
                icon="/icons/agent.svg">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </group>
        <action
                id="imux.CopySessionIdentity"
                class="com.github.izerui.imux.terminal.CopySessionIdentityAction"
                text="Copy Session Info"
                description="Copy the imux session type and ID to the clipboard"
                icon="AllIcons.Actions.Copy">
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="last"/>
        </action>
        <action
                id="imux.RenameSessionTitle"
                class="com.github.izerui.imux.terminal.RenameSessionTitleAction"
                text="Rename Session Title"
                description="Enter a new session title or generate one with this CLI's model"
                icon="AllIcons.Actions.Edit">
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="last"/>
        </action>
        <group
                id="imux.HandoffSession"
                class="com.github.izerui.imux.terminal.HandoffSessionActionGroup"
                popup="true">
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="last"/>
        </group>
        <action
                id="imux.ToggleSessionTrail"
                class="com.github.izerui.imux.terminal.ToggleSessionTrailAction"
                text="Toggle Session Trail Panel"
                description="Show or hide the session trail panel in the top-right corner of this session"/>
        <action
                id="imux.CloseNonSessionEditors"
                class="com.github.izerui.imux.terminal.CloseNonSessionEditorsAction"
                text="Close Non-Session Tabs"
                description="Close all editor tabs except AI agent sessions"
                icon="AllIcons.General.CloseSmallHovered">
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="before"
                          relative-to-action="imux.CopySessionIdentity"/>
        </action>
    </actions>
</idea-plugin>
